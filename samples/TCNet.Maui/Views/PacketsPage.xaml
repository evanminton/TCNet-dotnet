<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TCNet.Maui.ViewModels"
             xmlns:svc="clr-namespace:TCNet.Maui.Services"
             x:Class="TCNet.Maui.Views.PacketsPage"
             x:DataType="vm:PacketsViewModel"
             Title="Packets">
    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <SearchBar Text="{Binding Filter}" Placeholder="Filter: packet name, node, summary, address" />
            <Button Grid.Column="1" Text="Clear" Command="{Binding ClearCommand}" />
        </Grid>
        <FlexLayout Grid.Row="1" Wrap="Wrap" AlignItems="Center">
            <CheckBox IsChecked="{Binding Paused}" /><Label Text="Pause" VerticalOptions="Center" Margin="0,0,16,0" />
            <CheckBox IsChecked="{Binding LogTime}" /><Label Text="Log Time packets (high rate)" VerticalOptions="Center" Margin="0,0,16,0" />
            <CheckBox IsChecked="{Binding LogSent}" /><Label Text="Log sent packets" VerticalOptions="Center" />
        </FlexLayout>
        <CollectionView x:Name="List" Grid.Row="2" ItemsSource="{Binding Packets}" SelectionMode="Single" SelectionChanged="OnSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:PacketItem">
                    <Grid ColumnDefinitions="95,40,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" Padding="0,3">
                        <Label Text="{Binding Time}" Style="{StaticResource Mono}" FontSize="12" />
                        <Label Grid.Column="1" Text="{Binding Direction}" TextColor="{Binding DirectionColor}" FontAttributes="Bold" FontSize="12" />
                        <Label Grid.Column="2">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Title}" FontAttributes="Bold" />
                                    <Span Text="   " />
                                    <Span Text="{Binding From}" />
                                    <Span Text="   " />
                                    <Span Text="{Binding EndPoint}" TextColor="Gray" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
