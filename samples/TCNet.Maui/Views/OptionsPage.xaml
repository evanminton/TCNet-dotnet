<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TCNet.Maui.ViewModels"
             x:Class="TCNet.Maui.Views.OptionsPage"
             x:DataType="vm:OptionsViewModel"
             Title="Reference">
    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <SearchBar Text="{Binding Search}" Placeholder="Search packets, fields, options, vendors…" />
            <Button Grid.Column="1" Text="Copy as Markdown" Command="{Binding CopyCommand}" />
        </Grid>
        <Label Grid.Row="1" Text="{Binding Status}" IsVisible="{Binding HasStatus}" Style="{StaticResource Caption}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:ReferenceGroup">
                    <Label Text="{Binding Name}" Style="{StaticResource Heading}" Margin="0,14,0,4" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ReferenceRow">
                    <Grid ColumnDefinitions="80,220,*" ColumnSpacing="8" Padding="0,2">
                        <Label Text="{Binding Value}" Style="{StaticResource Mono}" />
                        <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" />
                        <Label Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
