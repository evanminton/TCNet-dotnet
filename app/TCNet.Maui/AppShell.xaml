<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:TCNet.Maui.Views"
       x:Class="TCNet.Maui.AppShell"
       Title="TCNet"
       FlyoutBehavior="{OnIdiom Desktop=Locked, Default=Flyout}">
    <FlyoutItem Title="Live"><ShellContent Route="live" ContentTemplate="{DataTemplate views:LivePage}" /></FlyoutItem>
    <FlyoutItem Title="Nodes"><ShellContent Route="nodes" ContentTemplate="{DataTemplate views:NodesPage}" /></FlyoutItem>
    <FlyoutItem Title="Mixer"><ShellContent Route="mixer" ContentTemplate="{DataTemplate views:MixerPage}" /></FlyoutItem>
    <FlyoutItem Title="Packets"><ShellContent Route="packets" ContentTemplate="{DataTemplate views:PacketsPage}" /></FlyoutItem>
    <FlyoutItem Title="Send"><ShellContent Route="send" ContentTemplate="{DataTemplate views:SendPage}" /></FlyoutItem>
    <FlyoutItem Title="Master"><ShellContent Route="master" ContentTemplate="{DataTemplate views:MasterPage}" /></FlyoutItem>
    <FlyoutItem Title="Reference"><ShellContent Route="reference" ContentTemplate="{DataTemplate views:ReferencePage}" /></FlyoutItem>
    <FlyoutItem Title="Settings"><ShellContent Route="settings" ContentTemplate="{DataTemplate views:SettingsPage}" /></FlyoutItem>
</Shell>
