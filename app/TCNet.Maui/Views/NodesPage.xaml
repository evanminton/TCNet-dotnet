<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TCNet.Maui.ViewModels"
             xmlns:svc="clr-namespace:TCNet.Maui.Services"
             x:Class="TCNet.Maui.Views.NodesPage"
             x:DataType="vm:NodesViewModel"
             Title="Nodes">
    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="8">
        <Label Text="{Binding App.Status}" Style="{StaticResource Caption}" />
        <CollectionView x:Name="List" Grid.Row="1" ItemsSource="{Binding Nodes}" SelectionMode="Single" SelectionChanged="OnSelected">
            <CollectionView.EmptyView>
                <Label Text="No nodes yet. A node appears when its Opt-IN (every second, UDP 60000) or any other packet arrives."
                       Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:NodeRow">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Title}" Style="{StaticResource Heading}" />
                            <Label Text="{Binding Line1}" />
                            <Label Text="{Binding Line2}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
