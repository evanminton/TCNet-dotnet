<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TCNet</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>TCNet</PackageId>
    <Description>TCNet Link Specification V3.5.1B for .NET 10: every packet type with field-level human-readable descriptions, chunk reassembly, node discovery, time sync, data requests, control, time packet streaming and master election.</Description>
    <PackageTags>tcnet;timecode;pioneer;showkontrol;dj;lighting;maui</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/evanminton/TCNet-dotnet</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="TCNet.Tests" />
  </ItemGroup>
</Project>
