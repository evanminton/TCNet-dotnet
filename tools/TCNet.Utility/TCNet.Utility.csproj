<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Not "tcnet": that differs from the library's TCNet.dll only by case, so the two assemblies collide.
         The command is still tcnet (ToolCommandName); the build output is TCNet.Utility(.dll/.exe). -->
    <AssemblyName>TCNet.Utility</AssemblyName>
    <RootNamespace>TCNet.Utility</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tcnet</ToolCommandName>
    <PackageId>TCNet.Utility</PackageId>
    <Description>tcnet: command-line TCNet monitor, requester, controller, master simulator and spec reference.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TCNet/TCNet.csproj" />
  </ItemGroup>
</Project>
